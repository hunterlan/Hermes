<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Fluent overrides: compact tabs with an accent pipe -->
      <x:Double x:Key="TabItemMinHeight">34</x:Double>
      <StaticResource x:Key="TabItemHeaderFontSize" ResourceKey="FontSizeBody" />
      <Thickness x:Key="TabItemHeaderMargin">10,0</Thickness>
      <StaticResource x:Key="ControlContentThemeFontSize" ResourceKey="FontSizeBody" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Order matters: among styles at the same precedence level, the later one wins. Keep these includes in order. -->
  <StyleInclude Source="avares://Hermes/Themes/Styles/Typography.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Buttons.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Tags.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/IconTag.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Picker.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Segmented.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/ButtonsSubtle.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Inputs.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Layout.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/SettingRow.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/CollapsibleSection.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Dialog.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Pills.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Tables.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Status.axaml" />
  <StyleInclude Source="avares://Hermes/Themes/Styles/Chain.axaml" />
</Styles>
