<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Hermes.App.Controls">

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Switches carry no on/off text; the setting's title says what they do -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <!-- Compact filter box with a search icon on the left (sidebar panes) -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="InnerLeftContent">
      <Template>
        <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="8,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
      </Template>
    </Setter>
  </Style>

  <!-- Borderless cell editor used in key/value tables -->
  <Style Selector="TextBox.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Bordered variable input for forms, where the box stands on its own instead of in a table cell -->
  <Style Selector="c|VariableTextBox.bordered">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
  </Style>

  <!-- Masked values: a Panel.valueCell holds the input and a TextBlock.maskDots; with .masked the dots show until
       the input has focus (to edit it). The input stays in place under the dots, so Tab and clicks still reach it. -->
  <Style Selector="Panel.valueCell > TextBlock.maskDots">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.valueCell.masked:not(:focus-within) > TextBlock.maskDots">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Panel.valueCell.masked:not(:focus-within) > c|VariableTextBox">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <!-- the frame of a masked field, drawn outside the input so the border stays while the input is hidden -->
  <Style Selector="Border.inputFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
  </Style>
</Styles>
