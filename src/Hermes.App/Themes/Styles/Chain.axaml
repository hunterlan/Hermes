<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Inheritance chain: collection → folders → request, source highlighted -->
  <Style Selector="Border.chainNode">
    <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.chainNode.source">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.chainLink">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="20,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.chainDetail">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.chainDetail.struck">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
</Styles>
