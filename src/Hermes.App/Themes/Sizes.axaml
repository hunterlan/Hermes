<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Size tokens. docs/design.md explains the roles; add a token here before using a new value. -->

  <!-- Type scale -->
  <x:Double x:Key="FontSizeMicro">10</x:Double>
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubtitle">14</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>
  <x:Double x:Key="FontSizeHeading">18</x:Double>
  <x:Double x:Key="FontSizeDisplay">32</x:Double>

  <!-- Corner radii. Pills and circles use half their height and stay literal. -->
  <CornerRadius x:Key="RadiusXSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="RadiusControl">7</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusPopup">12</CornerRadius>
  <CornerRadius x:Key="RadiusTabTop">8,8,0,0</CornerRadius>
  <!-- Inside a RadiusCard border with a 1px edge, so one less than the card -->
  <CornerRadius x:Key="RadiusCardInnerStart">9,0,0,9</CornerRadius>
  <CornerRadius x:Key="RadiusBarStart">4,0,0,4</CornerRadius>
  <CornerRadius x:Key="RadiusBarEnd">0,4,4,0</CornerRadius>

  <!-- Gaps between stacked or wrapped items (StackPanel.Spacing and similar) -->
  <x:Double x:Key="Spacing2">2</x:Double>
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing6">6</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing10">10</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing14">14</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
</ResourceDictionary>
