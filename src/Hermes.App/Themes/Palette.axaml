<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokens from the Hermes UI design: bg / panel / raise / line, text / mute / faint, amber accent.
       Status is never colour alone, and every text colour passes 4.5:1 on its background. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgPrimaryBrush" Color="#181B22" />
      <SolidColorBrush x:Key="BgSecondaryBrush" Color="#12141A" />
      <SolidColorBrush x:Key="BgTertiaryBrush" Color="#212631" />
      <SolidColorBrush x:Key="BgInputBrush" Color="#12141A" />
      <SolidColorBrush x:Key="BgHoverBrush" Color="#212631" />
      <SolidColorBrush x:Key="BgSelectedBrush" Color="#2A303C" />
      <SolidColorBrush x:Key="BgCodeBrush" Color="#0E1015" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2D3340" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3D4554" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EBF0" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3ACBA" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8590A1" />
      <SolidColorBrush x:Key="AccentBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#F5C86E" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#17120A" />
      <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#F0B84A" />
      <SolidColorBrush x:Key="SendBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="SendHoverBrush" Color="#F5C86E" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#62D6A0" />
      <SolidColorBrush x:Key="SuccessBgBrush" Color="#14342A" />
      <SolidColorBrush x:Key="RedirectBrush" Color="#80B9FF" />
      <SolidColorBrush x:Key="InfoBrush" Color="#80B9FF" />
      <SolidColorBrush x:Key="InfoBgBrush" Color="#172A44" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="WarningBgBrush" Color="#3A2F14" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FF8179" />
      <SolidColorBrush x:Key="ErrorBgBrush" Color="#3A1C1E" />
      <SolidColorBrush x:Key="VarResolvedBrush" Color="#80B9FF" />
      <SolidColorBrush x:Key="VarResolvedBgBrush" Color="#172A44" />
      <SolidColorBrush x:Key="VarUnresolvedBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="VarUnresolvedBgBrush" Color="#3A2F14" />
      <SolidColorBrush x:Key="MethodGETBrush" Color="#80B9FF" />
      <SolidColorBrush x:Key="MethodPOSTBrush" Color="#62D6A0" />
      <SolidColorBrush x:Key="MethodPUTBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="MethodPATCHBrush" Color="#F0B84A" />
      <SolidColorBrush x:Key="MethodDELETEBrush" Color="#FF8179" />
      <SolidColorBrush x:Key="MethodHEADBrush" Color="#80B9FF" />
      <SolidColorBrush x:Key="MethodOPTIONSBrush" Color="#A3ACBA" />
      <SolidColorBrush x:Key="MethodOTHERBrush" Color="#A3ACBA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgSecondaryBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="BgTertiaryBrush" Color="#ECEEF3" />
      <SolidColorBrush x:Key="BgInputBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="BgHoverBrush" Color="#ECEEF3" />
      <SolidColorBrush x:Key="BgSelectedBrush" Color="#E2E5EC" />
      <SolidColorBrush x:Key="BgCodeBrush" Color="#EEF0F5" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D3D8E1" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#B4BCC9" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#161A22" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#465062" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#586274" />
      <SolidColorBrush x:Key="AccentBrush" Color="#8F5600" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#7A4900" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#8F5600" />
      <SolidColorBrush x:Key="SendBrush" Color="#8F5600" />
      <SolidColorBrush x:Key="SendHoverBrush" Color="#7A4900" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#0D6E45" />
      <SolidColorBrush x:Key="SuccessBgBrush" Color="#DFF3E9" />
      <SolidColorBrush x:Key="RedirectBrush" Color="#1B5BB8" />
      <SolidColorBrush x:Key="InfoBrush" Color="#1B5BB8" />
      <SolidColorBrush x:Key="InfoBgBrush" Color="#E1ECFB" />
      <SolidColorBrush x:Key="WarningBrush" Color="#7D5200" />
      <SolidColorBrush x:Key="WarningBgBrush" Color="#FBEFD4" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#B0241C" />
      <SolidColorBrush x:Key="ErrorBgBrush" Color="#FBE4E2" />
      <SolidColorBrush x:Key="VarResolvedBrush" Color="#1B5BB8" />
      <SolidColorBrush x:Key="VarResolvedBgBrush" Color="#E1ECFB" />
      <SolidColorBrush x:Key="VarUnresolvedBrush" Color="#7D5200" />
      <SolidColorBrush x:Key="VarUnresolvedBgBrush" Color="#FBEFD4" />
      <SolidColorBrush x:Key="MethodGETBrush" Color="#1B5BB8" />
      <SolidColorBrush x:Key="MethodPOSTBrush" Color="#0D6E45" />
      <SolidColorBrush x:Key="MethodPUTBrush" Color="#7D5200" />
      <SolidColorBrush x:Key="MethodPATCHBrush" Color="#7D5200" />
      <SolidColorBrush x:Key="MethodDELETEBrush" Color="#B0241C" />
      <SolidColorBrush x:Key="MethodHEADBrush" Color="#1B5BB8" />
      <SolidColorBrush x:Key="MethodOPTIONSBrush" Color="#465062" />
      <SolidColorBrush x:Key="MethodOTHERBrush" Color="#465062" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="MonoFont">JetBrains Mono,Cascadia Code,Fira Code,Consolas,DejaVu Sans Mono,Menlo,monospace</FontFamily>
</ResourceDictionary>
