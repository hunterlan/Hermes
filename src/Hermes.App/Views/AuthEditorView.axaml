<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:c="using:Hermes.App.Controls"
             xmlns:v="using:Hermes.App.Views"
             xmlns:core="using:Hermes.Core.Models"
             x:Class="Hermes.App.Views.AuthEditorView"
             x:DataType="vm:AuthEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.form > :is(Control)">
      <Setter Property="Margin" Value="0,4" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*">
    <!-- type selection and where auth comes from -->
    <StackPanel Spacing="{StaticResource Spacing10}" Margin="0,0,24,0">
      <TextBlock Classes="section" Text="Auth Type" />
      <ListBox Classes="pills" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="{StaticResource Spacing4}" LineSpacing="{StaticResource Spacing4}" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <TextBlock Classes="secondary" Text="{Binding TypeDescription}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" />

      <StackPanel Margin="0,8,0,0" IsVisible="{Binding Chain.Count}">
        <TextBlock Classes="section" Text="Where auth comes from" Margin="0,0,0,8" />
        <v:InheritanceChainView Nodes="{Binding Chain}" />
      </StackPanel>

      <StackPanel Margin="0,8,0,0" IsVisible="{Binding UsageSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="section" Text="Overrides inside" Margin="0,0,0,6" IsVisible="{Binding HasOverrides}" />
        <ItemsControl ItemsSource="{Binding Overrides}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AuthOverride">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                <Grid ColumnDefinitions="50,*,Auto">
                  <c:MethodBadge Method="{Binding Method}" Compact="True" FontSize="{StaticResource FontSizeMicro}" IsVisible="{Binding !IsFolder}" VerticalAlignment="Center" />
                  <PathIcon Data="{StaticResource IconFolderOutline}" Width="13" Height="13" IsVisible="{Binding IsFolder}" HorizontalAlignment="Left"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding TypeLabel}" /></Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="secondary" FontSize="{StaticResource FontSizeSmall}" Text="{Binding UsageSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
      <Panel VerticalAlignment="Top">
        <!-- inherit / none -->
        <TextBlock Classes="secondary" IsVisible="{Binding IsInherit}" Text="{Binding TypeDescription}" TextWrapping="Wrap" />
        <TextBlock Classes="secondary" IsVisible="{Binding IsNone}" Text="This request does not use any authorization." />

        <!-- basic -->
        <Grid Classes="form" IsVisible="{Binding IsBasic}" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
          <TextBlock Classes="label" Text="Username" />
          <c:VariableTextBox Grid.Column="1" Classes="bordered" Text="{Binding BasicUsername}" PlaceholderText="Username" />
          <TextBlock Grid.Row="1" Classes="label" Text="Password" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BasicPassword}" PasswordChar="•" RevealPassword="False" PlaceholderText="Password" Classes="revealPasswordButton" />
        </Grid>

        <!-- bearer -->
        <Grid Classes="form" IsVisible="{Binding IsBearer}" ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Token" />
          <v:SecretVariableField Grid.Column="1" Text="{Binding BearerToken}" PlaceholderText="Token" Secret="{Binding BearerTokenSecret}" />
        </Grid>

        <!-- api key -->
        <Grid Classes="form" IsVisible="{Binding IsApiKey}" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="label" Text="Key" />
          <c:VariableTextBox Grid.Column="1" Classes="bordered" Text="{Binding ApiKeyKey}" PlaceholderText="Key" />
          <TextBlock Grid.Row="1" Classes="label" Text="Value" />
          <v:SecretVariableField Grid.Row="1" Grid.Column="1" Text="{Binding ApiKeyValue}" PlaceholderText="Value" Secret="{Binding ApiKeyValueSecret}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Add to" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ApiKeyLocations}" SelectedItem="{Binding SelectedApiKeyLocation}" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- oauth2 -->
        <ScrollViewer IsVisible="{Binding IsOAuth2}">
          <StackPanel Spacing="{StaticResource Spacing14}" Margin="0,0,12,12">
            <StackPanel Spacing="{StaticResource Spacing8}">
              <TextBlock Classes="section" Text="Current Token" />
              <Grid Classes="form" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Access Token" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                  <v:SecretVariableField Text="{Binding OAuthAccessToken}" PlaceholderText="Token" Secret="{Binding AccessTokenSecret}" />
                  <Button Grid.Column="1" Classes="ghost" Content="Clear" Margin="6,0,0,0" Command="{Binding ClearTokenCommand}" />
                </Grid>
                <TextBlock Grid.Row="1" Classes="label" Text="Header Prefix" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OAuthHeaderPrefix}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="tertiary" FontSize="{StaticResource FontSizeSmall}" Text="{Binding TokenExpiry}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="{StaticResource Spacing8}">
              <TextBlock Classes="section" Text="Configure New Token" />
              <Grid Classes="form" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Grant Type" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding GrantTypes}" SelectedItem="{Binding SelectedGrantType}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Classes="label" Text="Callback URL" IsVisible="{Binding IsAuthCodeGrant}" />
                <TextBox Name="CallbackUrlBox" Grid.Row="1" Grid.Column="1" Text="{Binding OAuthRedirectUri}" IsVisible="{Binding IsAuthCodeGrant}"
                         ToolTip.Tip="Must be a loopback URL (http://localhost:PORT/...) so Hermes can receive the code." />

                <TextBlock Grid.Row="2" Classes="label" Text="Auth URL" IsVisible="{Binding IsAuthCodeGrant}" />
                <c:VariableTextBox Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsAuthCodeGrant}" Classes="bordered" Text="{Binding OAuthAuthUrl}" PlaceholderText="https://example.com/oauth/authorize" />

                <TextBlock Grid.Row="3" Classes="label" Text="Access Token URL" />
                <c:VariableTextBox Name="AccessTokenUrlBox" Grid.Row="3" Grid.Column="1" Classes="bordered" Text="{Binding OAuthTokenUrl}" PlaceholderText="https://example.com/oauth/token" />

                <TextBlock Grid.Row="4" Classes="label" Text="Client ID" />
                <c:VariableTextBox Grid.Row="4" Grid.Column="1" Classes="bordered" Text="{Binding OAuthClientId}" PlaceholderText="Client ID" />

                <TextBlock Grid.Row="5" Classes="label" Text="Client Secret" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OAuthClientSecret}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Client Secret" />

                <TextBlock Grid.Row="6" Classes="label" Text="Username" IsVisible="{Binding IsPasswordGrant}" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OAuthUsername}" IsVisible="{Binding IsPasswordGrant}" />
                <TextBlock Grid.Row="7" Classes="label" Text="Password" IsVisible="{Binding IsPasswordGrant}" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding OAuthPassword}" PasswordChar="•" Classes="revealPasswordButton" IsVisible="{Binding IsPasswordGrant}" />

                <TextBlock Grid.Row="8" Classes="label" Text="Scope" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding OAuthScope}" PlaceholderText="e.g. read:org" />

                <TextBlock Grid.Row="9" Classes="label" Text="State" IsVisible="{Binding IsAuthCodeGrant}" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding OAuthState}" PlaceholderText="Generated if empty" IsVisible="{Binding IsAuthCodeGrant}" />

                <TextBlock Grid.Row="10" Classes="label" Text="PKCE" IsVisible="{Binding IsAuthCodeGrant}" />
                <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding OAuthUsePkce}" Content="Use PKCE (SHA-256)" IsVisible="{Binding IsAuthCodeGrant}" />

                <TextBlock Grid.Row="11" Classes="label" Text="Client Authentication" />
                <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding ClientAuthOptions}" SelectedItem="{Binding SelectedClientAuth}" HorizontalAlignment="Stretch" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing12}" Margin="140,6,0,0">
                <Button Classes="accent" Command="{Binding TokenButtonCommand}">
                  <Panel>
                    <TextBlock Text="Get New Access Token" IsVisible="{Binding !IsFetchingToken}" />
                    <TextBlock Text="Cancel" IsVisible="{Binding IsFetchingToken}" />
                  </Panel>
                </Button>
                <TextBlock Text="{Binding TokenStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="secondary" MaxWidth="460" />
              </StackPanel>
              <!-- why getting a token failed: the same four parts as the response pane's failure, compact -->
              <StackPanel Name="TokenFailurePanel" Margin="140,6,0,0" MaxWidth="{StaticResource WidthFailureMax}" HorizontalAlignment="Left"
                          Spacing="{StaticResource Spacing8}" IsVisible="{Binding IsFailureShown}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Spacing8}">
                  <PathIcon Width="{StaticResource SizeFailureIconInline}" Height="{StaticResource SizeFailureIconInline}" VerticalAlignment="Top"
                            Data="{Binding FailureIconKey, Converter={x:Static vm:UiConverters.IconFromKey}}" Foreground="{DynamicResource ErrorBrush}" />
                  <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing2}">
                    <SelectableTextBlock Name="TokenFailureHeadlineText" Text="{Binding FailureHeadline}" FontSize="{StaticResource FontSizeSubtitle}"
                                         FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock Name="TokenFailureFactsText" Text="{Binding FailureFacts}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <StackPanel IsVisible="{Binding IsFailureActionShown}" Spacing="{StaticResource Spacing6}">
                  <Button Name="TokenFailureActionButton" Classes="outline" HorizontalAlignment="Left" Content="{Binding FailureActionLabel}"
                          Command="{Binding RunFailureActionCommand}" />
                  <TextBlock Name="TokenFailureActionCaptionText" Classes="secondary" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                             Text="{Binding FailureActionCaption}" IsVisible="{Binding IsFailureActionCaptionShown}" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding IsFailureDetailsShown}">
                  <c:CollapsibleSection Name="TokenFailureDetailsSection" Header="Details" IsExpanded="{Binding FailureDetailsExpanded}">
                    <StackPanel Spacing="{StaticResource Spacing8}" Margin="0,0,0,4">
                      <ItemsControl ItemsSource="{Binding FailureDetails}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="core:FailureDetail">
                            <Grid ColumnSpacing="{StaticResource Spacing12}" Margin="0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TokenFailureDetailLabel" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Classes="tertiary" FontSize="{StaticResource FontSizeSmall}" Text="{Binding Label}" />
                              <SelectableTextBlock Grid.Column="1" FontSize="{StaticResource FontSizeSmall}" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border IsVisible="{Binding IsFailureOriginalMessageShown}" Background="{DynamicResource BgCodeBrush}"
                              CornerRadius="{StaticResource RadiusMedium}" Padding="10,8">
                        <SelectableTextBlock Name="TokenFailureOriginalMessageText" Classes="mono" Text="{Binding FailureOriginalMessage}"
                                             FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      </Border>
                      <Button Name="CopyTokenFailureDetailsButton" Classes="ghost" HorizontalAlignment="Left" Content="Copy details"
                              FontSize="{StaticResource FontSizeSmall}" Command="{Binding CopyFailureDetailsCommand}" />
                    </StackPanel>
                  </c:CollapsibleSection>
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing8}" Margin="140,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                    IsVisible="{Binding AuthorizationUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Text="{Binding AuthorizationUrl}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Copy" Command="{Binding CopyAuthorizationUrlCommand}" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
