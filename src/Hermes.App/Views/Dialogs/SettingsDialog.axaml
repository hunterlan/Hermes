<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hermes.App.ViewModels"
        xmlns:c="using:Hermes.App.Controls"
        x:Class="Hermes.App.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="Settings" Width="640" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="c|SettingRow">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
    <c:DialogHeader Title="Settings" Margin="0,0,0,16" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Classes="section" Text="APPEARANCE" Margin="0,0,0,10" />
        <c:SettingRow Title="Theme">
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="220" />
        </c:SettingRow>
        <c:SettingRow Title="Layout" Hint="Where the response pane is shown.">
          <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Width="220" />
        </c:SettingRow>
        <c:SettingRow Title="Tabs" Hint="When off, only one tab is open. Opening another item replaces it, and asks to save unsaved changes first.">
          <ToggleSwitch IsChecked="{Binding ShowTabs}" />
        </c:SettingRow>
        <c:SettingRow Title="Tabs kept ready"
                      Hint="The most recently used tabs, the open one included, switch back instantly. Each one keeps its view in memory: a few MB, or about 60 MB with a 1 MB response. Other tabs take a moment to reload.">
          <c:SettingRow.Details>
            <TextBlock Text="{Binding TabViewPoolSizeError}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                       IsVisible="{Binding TabViewPoolSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </c:SettingRow.Details>
          <TextBox Width="140" VerticalAlignment="Top" Text="{Binding TabViewPoolSizeText}" />
        </c:SettingRow>

        <TextBlock Classes="section" Text="REQUESTS" Margin="0,8,0,10" />
        <c:SettingRow Title="Request timeout (ms)" Hint="How long to wait for a response. 0 means wait forever.">
          <TextBox Width="140" Text="{Binding TimeoutText}" />
        </c:SettingRow>
        <c:SettingRow Title="SSL certificate verification" Hint="Verify server certificates. Individual requests can override this.">
          <ToggleSwitch IsChecked="{Binding VerifySsl}" />
        </c:SettingRow>
        <c:SettingRow Title="Automatically follow redirects" Hint="Individual requests can override this.">
          <ToggleSwitch IsChecked="{Binding FollowRedirects}" />
        </c:SettingRow>
        <c:SettingRow Title="Max response size for pretty view (MB)"
                      Hint="Larger responses are shown as raw text without highlighting to stay responsive.">
          <TextBox Width="140" Text="{Binding MaxPrettySizeText}" />
        </c:SettingRow>
        <c:SettingRow Title="Cookies" Hint="{Binding CookieStatus}">
          <Button Content="Clear all cookies" Command="{Binding ClearCookiesCommand}" />
        </c:SettingRow>

        <TextBlock Classes="section" Text="DATA" Margin="0,8,0,10" />
        <c:SettingRow Title="History retention (days)"
                      Hint="Number of days to keep, counting today. 0 keeps history forever.">
          <c:SettingRow.Details>
            <TextBlock Text="{Binding HistoryRetentionError}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                       IsVisible="{Binding HistoryRetentionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </c:SettingRow.Details>
          <TextBox Width="140" VerticalAlignment="Top" Text="{Binding HistoryRetentionText}" />
        </c:SettingRow>
        <c:SettingRow Title="Data folder" Hint="Collections, environments, history and session are stored here as JSON files." IsStacked="True">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding DataDirectory}" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseDataDirectoryCommand}" />
          </Grid>
        </c:SettingRow>
        <TextBlock Classes="section" Text="HELP" Margin="0,8,0,10" />
        <c:SettingRow Title="User manual" Hint="Works offline. Closes this dialog without saving changes.">
          <Button Content="Open manual" Command="{Binding OpenManualCommand}" />
        </c:SettingRow>
        <TextBlock Text="Restart Hermes to use the new data folder." Foreground="{DynamicResource AccentBrush}" FontSize="{StaticResource FontSizeSmall}"
                   IsVisible="{Binding DataDirectoryChanged}" Margin="0,-8,0,8" />
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding SaveError}" Margin="0,10,0,0" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
               Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <c:DialogFooter Grid.Row="3">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </c:DialogFooter>
  </Grid>
</Window>
