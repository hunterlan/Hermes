<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hermes.App.ViewModels"
        xmlns:c="using:Hermes.App.Controls"
        x:Class="Hermes.App.Views.Dialogs.CodeSnippetDialog"
        x:DataType="vm:CodeSnippetViewModel"
        Title="Code snippet" Width="760" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <c:DialogHeader Margin="0,0,0,12" Title="Code snippet" Subtitle="cURL, with variables and auth resolved">
      <Button Command="{Binding CopyCommand}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing6}">
          <PathIcon Width="14" Height="14" Data="{StaticResource IconCopy}" />
          <TextBlock Text="{Binding CopyText}" />
        </StackPanel>
      </Button>
    </c:DialogHeader>
    <Border Grid.Row="1" Classes="table" Background="{DynamicResource BgSecondaryBrush}">
      <c:CodeEditor Text="{Binding Code, Mode=OneWay}" Language="text" IsReadOnly="True" WordWrap="True" ShowLineNumbers="False" />
    </Border>
    <c:DialogFooter Grid.Row="2" Margin="0,12,0,0" CloseButtonText="Close" />
  </Grid>
</Window>
