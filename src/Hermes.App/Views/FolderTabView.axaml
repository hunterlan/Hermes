<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:v="using:Hermes.App.Views"
             x:Class="Hermes.App.Views.FolderTabView"
             x:DataType="vm:FolderTabViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20,14,20,0">
    <TextBlock Classes="secondary" Text="{Binding Breadcrumb}" Margin="0,0,0,6" />
    <v:ContainerTabHeader Grid.Row="1" Icon="{StaticResource IconFolderOutline}" Title="{Binding Name}" SaveCommand="{Binding SaveCommand}" />

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedSection}" Margin="0,8,0,0">
      <TabItem Header="Overview">
        <StackPanel Spacing="10" MaxWidth="820" HorizontalAlignment="Left" Margin="0,10,0,0">
          <TextBlock Classes="section" Text="Description" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MinWidth="560"
                   VerticalContentAlignment="Top" PlaceholderText="Add a description" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Authorization">
        <v:ContainerAuthorizationSection ContainerNoun="folder" DataContext="{Binding Auth}" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
