<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:c="using:Hermes.App.Controls"
             xmlns:v="using:Hermes.App.Views"
             x:Class="Hermes.App.Views.KeyValueTable"
             x:DataType="vm:KeyValueListViewModel">
  <StackPanel Spacing="{StaticResource Spacing6}">
    <Border Classes="table" IsVisible="{Binding !IsBulkEdit}">
      <StackPanel>
        <!-- header -->
        <Border Classes="tableHeader">
          <Grid ColumnDefinitions="34,*,*,*,34">
            <TextBlock Grid.Column="1" Classes="section" Text="Key" />
            <Border Grid.Column="2" Classes="cellSep">
              <TextBlock Classes="section" Text="Value" />
            </Border>
            <Border Grid.Column="3" Grid.ColumnSpan="2" Classes="cellSep">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="Description" />
                <Button Grid.Column="1" Classes="link" Content="Bulk Edit" FontSize="{StaticResource FontSizeSmall}" Margin="8,0"
                        Command="{Binding ToggleBulkEditCommand}" IsVisible="{Binding !KeysReadOnly}" />
              </Grid>
            </Border>
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyValueRowViewModel">
              <Border Classes="tableRow">
                <Grid ColumnDefinitions="34,*,*,*,34" MinHeight="31">
                  <CheckBox IsChecked="{Binding Enabled}" IsVisible="{Binding ShowCheckBox}"
                            HorizontalAlignment="Center" MinWidth="0" Padding="0" />
                  <!-- a long tag trims; it must not widen the Key column and push the others out of line -->
                  <c:ShrinkableCell Grid.Column="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <!-- the key always stays readable; what doesn't fit is clipped on the tag side -->
                      <ColumnDefinition Width="*" MinWidth="90" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Classes="cell" Text="{Binding Key}" PlaceholderText="Key"
                             IsReadOnly="{Binding Owner.KeysReadOnly}" />
                    <!-- trailing notes (headers only); empty ones take no space -->
                    <Border Grid.Column="2" Classes="tag info" IsVisible="{Binding HasTag}" Margin="0,0,4,0">
                      <TextBlock Text="{Binding TagText}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="3" Classes="tag warn" IsVisible="{Binding HasWarningTag}" Margin="0,0,4,0">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing4}">
                        <PathIcon Width="11" Height="11" Data="{StaticResource IconAlert}" />
                        <TextBlock Text="{Binding WarningTagText}" />
                      </StackPanel>
                    </Border>
                    <ComboBox Grid.Column="1" IsVisible="{Binding Owner.AllowFiles}" MinHeight="24" FontSize="{StaticResource FontSizeCaption}"
                              Padding="6,0" Margin="2,0,4,0" VerticalAlignment="Center" BorderThickness="0"
                              Background="Transparent"
                              SelectedIndex="{Binding IsFile, Converter={x:Static v:KeyValueTable.BoolToIndex}}">
                      <ComboBoxItem>Text</ComboBoxItem>
                      <ComboBoxItem>File</ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  </c:ShrinkableCell>
                  <Border Grid.Column="2" Classes="cellSep">
                    <Panel>
                      <!-- a sensitive value shows dots until it is revealed or has focus (to edit it) -->
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsFile}">
                        <Panel Classes="valueCell" Classes.masked="{Binding Sensitive.ShowMask}">
                          <c:VariableTextBox Text="{Binding Value}" PlaceholderText="Value" Margin="8,0" />
                          <TextBlock Classes="mono maskDots" Text="{Binding Sensitive.DisplayValue}" Margin="8,0"
                                     VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Panel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding Sensitive.IsSensitive}">
                          <Button Classes="icon" Command="{Binding Sensitive.ToggleRevealCommand}"
                                  ToolTip.Tip="{Binding Sensitive.RevealToolTip}" AutomationProperties.Name="{Binding Sensitive.RevealToolTip}">
                            <Panel>
                              <PathIcon Data="{StaticResource IconEye}" IsVisible="{Binding !Sensitive.IsRevealed}" />
                              <PathIcon Data="{StaticResource IconEyeOff}" IsVisible="{Binding Sensitive.IsRevealed}" />
                            </Panel>
                          </Button>
                          <Button Classes="icon" Command="{Binding Sensitive.CopyCommand}"
                                  ToolTip.Tip="Copy value" AutomationProperties.Name="Copy value">
                            <Panel>
                              <PathIcon Data="{StaticResource IconCopy}" IsVisible="{Binding !Sensitive.IsCopied}" />
                              <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding Sensitive.IsCopied}"
                                        Foreground="{DynamicResource SuccessBrush}" />
                            </Panel>
                          </Button>
                          <TextBlock Text="Copied" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="2,0,4,0" IsVisible="{Binding Sensitive.IsCopied}" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsFile}" Margin="4,0">
                        <Button Classes="ghost" Content="Select file" Command="{Binding PickFileCommand}" FontSize="{StaticResource FontSizeSmall}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Margin="6,0"
                                   TextTrimming="CharacterEllipsis" Classes="secondary" />
                      </Grid>
                    </Panel>
                  </Border>
                  <Border Grid.Column="3" Classes="cellSep">
                    <TextBox Classes="cell" Text="{Binding Description}" PlaceholderText="Description" />
                  </Border>
                  <Button Grid.Column="4" Classes="icon" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                          ToolTip.Tip="Delete">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- bulk edit -->
    <StackPanel Spacing="{StaticResource Spacing6}" IsVisible="{Binding IsBulkEdit}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="tertiary" Text="Rows are separated by new lines. Keys and values are separated by ':'. Prepend '//' to disable a row." VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="link" Content="Key-Value Edit" Command="{Binding ToggleBulkEditCommand}" />
      </Grid>
      <TextBox Classes="mono" Text="{Binding BulkText}" AcceptsReturn="True" MinHeight="160" TextWrapping="NoWrap"
               VerticalContentAlignment="Top" />
    </StackPanel>
  </StackPanel>
</UserControl>
