<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:v="using:Hermes.App.Views"
             x:Class="Hermes.App.Views.HeaderListView">
  <UserControl.Styles>
    <!-- Overridden rows are crossed out (and tagged); skipped rows are dimmed (and tagged) -->
    <Style Selector="Grid.overridden > TextBlock.mono">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Grid.skipped > TextBlock.mono">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- the full-value box, in the look of the pickers' popovers -->
    <Style Selector="Border.sensitivePopup">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.valueBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BgCodeBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <!-- optional heading with a hint next to it -->
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,4,8,2"
                IsVisible="{Binding $parent[v:HeaderListView].HasHeading}">
      <TextBlock Classes="section" Text="{Binding $parent[v:HeaderListView].Heading}" VerticalAlignment="Center" />
      <TextBlock Classes="tertiary" FontSize="{StaticResource FontSizeSmall}" Text="{Binding $parent[v:HeaderListView].Hint}" VerticalAlignment="Center" />
    </StackPanel>
    <!-- read-only rows: [checkbox] key, value, [source chip], tag -->
    <ItemsControl ItemsSource="{Binding $parent[v:HeaderListView].Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HeaderRowViewModel">
          <Grid Name="Row" ColumnDefinitions="Auto,200,*,Auto,Auto,Auto" MinHeight="28" Margin="8,0"
                Classes.overridden="{Binding IsOverridden}" Classes.skipped="{Binding IsSkipped}">
            <CheckBox IsVisible="{Binding CanSkip}" IsChecked="{Binding IsSent}" IsEnabled="{Binding CanToggleSent}"
                      MinWidth="0" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding CheckBoxName}" />
            <TextBlock Grid.Column="1" Classes="mono tertiary" Text="{Binding Key}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KeyToolTip}" />
            <!-- a value never wraps: the row keeps its height, and the expand button shows all of it -->
            <TextBlock Name="ValueText" Grid.Column="2" Classes="mono tertiary" Text="{Binding Sensitive.DisplayValue}" FontSize="{StaticResource FontSizeSmall}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,4" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
              <Button Classes="icon" IsVisible="{Binding Sensitive.IsSensitive}" Command="{Binding Sensitive.ToggleRevealCommand}"
                      ToolTip.Tip="{Binding Sensitive.RevealToolTip}" AutomationProperties.Name="{Binding Sensitive.RevealToolTip}">
                <Panel>
                  <PathIcon Data="{StaticResource IconEye}" IsVisible="{Binding !Sensitive.IsRevealed}" />
                  <PathIcon Data="{StaticResource IconEyeOff}" IsVisible="{Binding Sensitive.IsRevealed}" />
                </Panel>
              </Button>
              <Button Classes="icon" IsVisible="{Binding Sensitive.CanExpand}" Command="{Binding Sensitive.ToggleExpandCommand}"
                      ToolTip.Tip="Show full value" AutomationProperties.Name="Show full value">
                <PathIcon Data="{StaticResource IconExpand}" />
              </Button>
              <Button Classes="icon" IsVisible="{Binding Sensitive.IsSensitive}" Command="{Binding Sensitive.CopyCommand}"
                      ToolTip.Tip="Copy value" AutomationProperties.Name="Copy value">
                <Panel>
                  <PathIcon Data="{StaticResource IconCopy}" IsVisible="{Binding !Sensitive.IsCopied}" />
                  <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding Sensitive.IsCopied}"
                            Foreground="{DynamicResource SuccessBrush}" />
                </Panel>
              </Button>
              <TextBlock Text="Copied" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                         Margin="2,0,4,0" IsVisible="{Binding Sensitive.IsCopied}" />
            </StackPanel>
            <!-- the full value overlays the rows below it, so the row keeps its height -->
            <Popup PlacementTarget="{Binding #Row}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
                   IsOpen="{Binding Sensitive.IsExpanded, Mode=TwoWay}">
              <Border Classes="sensitivePopup" Width="440">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="mono" Text="{Binding Key}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{StaticResource FontSizeCaption}" Text="{Binding Sensitive.CharacterCountText}"
                               VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="valueBox">
                    <ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Name="FullValueText" Classes="mono" Text="{Binding Sensitive.DisplayValue}" FontSize="{StaticResource FontSizeSmall}"
                                           TextWrapping="Wrap" Margin="8,6" />
                    </ScrollViewer>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="Copied" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Sensitive.IsCopied}" />
                    <Button Classes="ghost" Command="{Binding Sensitive.CopyCommand}" AutomationProperties.Name="Copy value">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="12" Height="12" Data="{StaticResource IconCopy}" />
                        <TextBlock Text="Copy" />
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding Sensitive.HideValueCommand}" IsVisible="{Binding Sensitive.IsSensitive}"
                            AutomationProperties.Name="Hide value">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="12" Height="12" Data="{StaticResource IconEyeOff}" />
                        <TextBlock Text="Hide" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Popup>
            <Button Grid.Column="4" Classes="ghost" IsVisible="{Binding HasSource}" Command="{Binding OpenSourceTabCommand}"
                    ToolTip.Tip="{Binding SourceToolTip}" Margin="0,0,6,0" Padding="6,1" FontSize="{StaticResource FontSizeCaption}"
                    VerticalAlignment="Center" AutomationProperties.Name="{Binding SourceToolTip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="11" Height="11" Data="{StaticResource IconFolderOutline}" IsVisible="{Binding !IsSourceCollection}" />
                <PathIcon Width="11" Height="11" Data="{StaticResource IconCollections}" IsVisible="{Binding IsSourceCollection}" />
                <TextBlock Text="{Binding SourceName}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Border Grid.Column="5" Classes="tag" Classes.warn="{Binding ShowWarning}" IsVisible="{Binding ShowTag}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="11" Height="11" Data="{StaticResource IconAlert}" IsVisible="{Binding ShowWarning}" />
                <TextBlock Text="{Binding StatusText}" />
              </StackPanel>
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
