<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             x:Class="Hermes.App.Views.QuickLookTable"
             x:DataType="vm:QuickLookSection">
  <Panel>
    <TextBlock Classes="tertiary" FontSize="12" Text="No variables" IsVisible="{Binding IsEmpty}" />
    <StackPanel IsVisible="{Binding !IsEmpty}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickLookVariable">
            <Grid ColumnDefinitions="Auto,*" Margin="0,3">
              <TextBlock Text="{Binding Key}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="tertiary" FontSize="12" Text="{Binding MoreText}" IsVisible="{Binding HasMore}" />
    </StackPanel>
  </Panel>
</UserControl>
