<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sb="using:Hermes.App.ViewModels.Sidebar"
             xmlns:sbv="using:Hermes.App.Views.Sidebar"
             xmlns:c="using:Hermes.App.Controls"
             x:Class="Hermes.App.Views.Sidebar.EnvironmentsPaneView"
             x:DataType="sb:EnvironmentsPaneViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem" x:DataType="sb:EnvironmentItemViewModel">
      <Setter Property="IsVisible" Value="{Binding IsVisible}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.rowMenu">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.rowMenu">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Button Grid.Row="2" Classes="outline" Margin="12,6,12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Command="{Binding OpenMatrixCommand}" ToolTip.Tip="Every variable in every environment, side by side">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Data="{StaticResource IconEnvironment}" Width="13" Height="13" />
        <TextBlock Text="Compare all environments" />
      </StackPanel>
    </Button>
    <Grid ColumnDefinitions="Auto,*" Margin="8,8,8,6">
      <Button Classes="icon" Command="{Binding NewEnvironmentCommand}" ToolTip.Tip="Create new environment">
        <PathIcon Data="{StaticResource IconPlus}" />
      </Button>
      <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding Filter}" PlaceholderText="Search environments" MinHeight="28" Padding="8,3">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="8,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <ListBox Grid.Row="1" Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" Padding="4,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="sb:EnvironmentItemViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent" Tapped="OnItemTapped" ContextRequested="OnContextRequested">
            <!-- Globals keep the generic icon; environments show their colour -->
            <Panel Width="14" Margin="0,0,10,0">
              <PathIcon Data="{StaticResource IconEnvironment}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                        IsVisible="{Binding IsGlobals}" />
              <c:EnvironmentColorDot Color="{Binding Color}" HorizontalAlignment="Center" IsVisible="{Binding IsRegular}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !IsRenaming}" FontWeight="{Binding IsGlobals, Converter={x:Static sbv:EnvironmentsPaneView.BoldIf}}" />
            <TextBox Grid.Column="1" Text="{Binding Name, Mode=OneWay}" IsVisible="{Binding IsRenaming}" MinHeight="24" Padding="4,1"
                     KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" PropertyChanged="OnRenameBoxPropertyChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0">
              <Border Classes="tag err" IsVisible="{Binding ConfirmBeforeSend}" ToolTip.Tip="Asks before sending">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconLock}" Width="10" Height="10" />
                  <TextBlock Text="Confirm" />
                </StackPanel>
              </Border>
              <Border Classes="tag warn" IsVisible="{Binding IsActive}" ToolTip.Tip="Active environment">
                <TextBlock Text="Active" />
              </Border>
            </StackPanel>
            <Button Grid.Column="3" Classes="icon rowMenu" Width="22" Height="22" Padding="3" Click="OnMenuClick" ToolTip.Tip="More actions">
              <PathIcon Data="{StaticResource IconMore}" Width="13" Height="13" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
