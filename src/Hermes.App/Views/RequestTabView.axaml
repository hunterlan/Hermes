<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:c="using:Hermes.App.Controls"
             xmlns:v="using:Hermes.App.Views"
             xmlns:core="using:Hermes.Core.Models"
             x:Class="Hermes.App.Views.RequestTabView"
             x:DataType="vm:RequestTabViewModel">
  <UserControl.Styles>
    <!-- Collapsible section header: chevron, title, quiet summary -->
    <Style Selector="ToggleButton.sectionHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.sectionHeader:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader PathIcon.chevron">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked PathIcon.chevron">
      <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader TextBlock.summary">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,12,16,0">
    <!-- breadcrumb + name + actions -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Classes="tertiary" Text="{Binding Breadcrumb}" IsVisible="{Binding Breadcrumb, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" />
        <TextBlock Classes="tertiary" Text="/" IsVisible="{Binding Breadcrumb, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" />
        <Panel>
          <Button Classes="ghost" Padding="4,2" Command="{Binding StartRenameCommand}" IsVisible="{Binding !IsRenaming}"
                  Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Rename">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
          </Button>
          <TextBox Name="NameBox" Text="{Binding Name}" IsVisible="{Binding IsRenaming}" MinWidth="240" MinHeight="26" Padding="6,2"
                   LostFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
        </Panel>
        <Border Classes="tag ok" IsVisible="{Binding !IsDirty}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" />
            <TextBlock Text="Saved" />
          </StackPanel>
        </Border>
        <Border Classes="tag warn" IsVisible="{Binding IsDirty}">
          <TextBlock Text="Unsaved" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Classes="outline" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Save" VerticalAlignment="Center" />
            <Border Classes="kbd"><TextBlock Text="Ctrl S" /></Border>
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding SaveAsCommand}" Content="Save As" ToolTip.Tip="Save a copy to a collection" />
        <Button Classes="icon" Width="28" Height="28" Command="{Binding ShowCodeCommand}" ToolTip.Tip="Code snippet (cURL)">
          <PathIcon Data="{StaticResource IconCode}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- request bar: method | URL | Send, in one field -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BgInputBrush}"
            Height="40" Padding="0,0,4,0">
      <Grid ColumnDefinitions="Auto,1,*,Auto">
        <ComboBox Name="MethodBox" ItemsSource="{x:Static vm:RequestTabViewModel.Methods}" SelectedItem="{Binding SelectedMethod}"
                  Width="104" BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" FontWeight="SemiBold"
                  CornerRadius="9,0,0,9">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <c:MethodBadge Method="{Binding}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,9" />
        <c:VariableTextBox Grid.Column="2" Name="UrlBox" Margin="12,0" Text="{Binding Url}" Variables="{Binding Variables}"
                           PlaceholderText="Enter URL or paste cURL" SubmitCommand="{Binding SendCommand}" AllowMultilineInput="True" />
        <Button Grid.Column="3" Classes="send" Height="32" MinWidth="0" Padding="14,0" VerticalAlignment="Center"
                Command="{Binding SendCommand}" ToolTip.Tip="Send (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding SendButtonText}" VerticalAlignment="Center" />
            <Border Classes="kbd" BorderBrush="{DynamicResource AccentInkBrush}" Opacity="0.7">
              <TextBlock Text="Ctrl ↵" Foreground="{DynamicResource AccentInkBrush}" />
            </Border>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- the exact target after variable resolution, with the environment it came from -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="2,8,0,4"
                IsVisible="{Binding ResolvedUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <PathIcon Data="{StaticResource IconArrowRight}" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Classes="secondary" Text="Sends to" FontSize="12" VerticalAlignment="Center" />
      <SelectableTextBlock Classes="mono" Text="{Binding ResolvedUrl}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Border Classes="tag warn" IsVisible="{Binding ActiveEnvironmentName, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ActiveEnvironmentName}" />
      </Border>
    </StackPanel>

    <!-- request composer / response split -->
    <Grid Grid.Row="3" Name="SplitGrid" RowDefinitions="*,5,*" MinHeight="200" Margin="0,6,0,0">
      <ScrollViewer Name="RequestEditor" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,12">

          <!-- Params -->
          <Border Classes="section" BorderThickness="0" IsVisible="{Binding IsParamsSectionVisible}">
            <StackPanel>
              <ToggleButton Classes="sectionHeader" IsChecked="{Binding ParamsExpanded}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="chevron" />
                  <TextBlock Classes="title" Text="Params" />
                  <TextBlock Classes="summary" Text="{Binding ParamsSummary}" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Spacing="8" Margin="0,0,0,12" IsVisible="{Binding ParamsExpanded}">
                <v:KeyValueTable DataContext="{Binding Params}" Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
                <StackPanel Spacing="8" IsVisible="{Binding HasPathVariables}" Margin="0,4,0,0">
                  <TextBlock Classes="section" Text="Path variables" />
                  <v:KeyValueTable DataContext="{Binding PathVariables}" Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Body -->
          <Border Classes="section" IsVisible="{Binding IsBodySectionVisible}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <ToggleButton Classes="sectionHeader" IsChecked="{Binding BodyExpanded}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="chevron" />
                    <TextBlock Classes="title" Text="Body" />
                    <TextBlock Classes="summary" Text="{Binding BodySummary}" />
                  </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding BodyExpanded}">
                  <ComboBox ItemsSource="{x:Static vm:RequestTabViewModel.RawLanguages}" SelectedItem="{Binding SelectedRawLanguage}"
                            IsVisible="{Binding IsBodyRaw}" MinWidth="100" MinHeight="26" Padding="8,2" FontSize="12" />
                  <Button Classes="outline" Content="Format" FontSize="12" MinHeight="26" Padding="10,2" Command="{Binding BeautifyCommand}"
                          IsVisible="{Binding IsBodyRaw}" ToolTip.Tip="Beautify" />
                </StackPanel>
              </Grid>
              <Grid RowDefinitions="Auto,Auto" IsVisible="{Binding BodyExpanded}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
                  <RadioButton GroupName="BodyMode" Content="none" IsChecked="{Binding IsBodyNone, Mode=OneWay}"
                               Command="{Binding SetBodyModeCommand}" CommandParameter="{x:Static core:BodyMode.None}" />
                  <RadioButton GroupName="BodyMode" Content="form-data" IsChecked="{Binding IsBodyFormData, Mode=OneWay}"
                               Command="{Binding SetBodyModeCommand}" CommandParameter="{x:Static core:BodyMode.FormData}" />
                  <RadioButton GroupName="BodyMode" Content="x-www-form-urlencoded" IsChecked="{Binding IsBodyUrlEncoded, Mode=OneWay}"
                               Command="{Binding SetBodyModeCommand}" CommandParameter="{x:Static core:BodyMode.UrlEncoded}" />
                  <RadioButton GroupName="BodyMode" Content="raw" IsChecked="{Binding IsBodyRaw, Mode=OneWay}"
                               Command="{Binding SetBodyModeCommand}" CommandParameter="{x:Static core:BodyMode.Raw}" />
                  <RadioButton GroupName="BodyMode" Content="binary" IsChecked="{Binding IsBodyBinary, Mode=OneWay}"
                               Command="{Binding SetBodyModeCommand}" CommandParameter="{x:Static core:BodyMode.Binary}" />
                </StackPanel>

                <Panel Grid.Row="1">
                  <StackPanel IsVisible="{Binding IsBodyNone}" Spacing="6" Margin="0,4">
                    <TextBlock Classes="tertiary" Text="This request does not have a body." />
                    <TextBlock Classes="tertiary" FontSize="12" IsVisible="{Binding HasUnsupportedBody}" TextWrapping="Wrap"
                               Text="The imported body uses a mode Hermes doesn't support (e.g. GraphQL); it is kept for export." />
                  </StackPanel>
                  <v:KeyValueTable DataContext="{Binding FormData}" IsVisible="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).IsBodyFormData}"
                                   Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
                  <v:KeyValueTable DataContext="{Binding UrlEncoded}" IsVisible="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).IsBodyUrlEncoded}"
                                   Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
                  <Border Classes="table" IsVisible="{Binding IsBodyRaw}" Background="{DynamicResource BgCodeBrush}" Height="260">
                    <c:CodeEditor Text="{Binding RawBody}" Language="{Binding RawEditorLanguage}" />
                  </Border>
                  <StackPanel IsVisible="{Binding IsBodyBinary}" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <Button Classes="outline" Content="Select File" Command="{Binding SelectBinaryFileCommand}" />
                    <TextBlock Text="{Binding BinaryFileLabel}" VerticalAlignment="Center" Classes="secondary" />
                  </StackPanel>
                </Panel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Headers: yours, then the ones Hermes adds, so nothing sent is invisible -->
          <Border Classes="section">
            <StackPanel>
              <ToggleButton Classes="sectionHeader" IsChecked="{Binding HeadersExpanded}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="chevron" />
                  <TextBlock Classes="title" Text="Headers" />
                  <TextBlock Classes="summary" Text="{Binding HeadersSummary}" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Spacing="8" Margin="0,0,0,12" IsVisible="{Binding HeadersExpanded}">
                <v:KeyValueTable DataContext="{Binding Headers}" Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
                <ItemsControl ItemsSource="{Binding HiddenHeaders}" IsVisible="{Binding HiddenHeaders.Count}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:KeyValueItem">
                      <Grid ColumnDefinitions="200,*,Auto" MinHeight="28" Margin="8,0">
                        <TextBlock Classes="mono tertiary" Text="{Binding Key}" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="mono tertiary" Text="{Binding Value}" FontSize="12.5" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="8,4" />
                        <Border Grid.Column="2" Classes="tag"><TextBlock Text="added automatically" /></Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Auth: one line with where it comes from; expand to change it -->
          <Border Classes="section">
            <StackPanel>
              <ToggleButton Classes="sectionHeader" IsChecked="{Binding AuthExpanded}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="chevron" />
                  <TextBlock Classes="title" Text="Auth" />
                  <TextBlock Classes="summary" Text="{Binding Auth.Summary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </ToggleButton>
              <v:AuthEditorView DataContext="{Binding Auth}" Margin="0,0,0,12" IsVisible="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).AuthExpanded}"
                                Variables="{Binding $parent[v:RequestTabView].((vm:RequestTabViewModel)DataContext).Variables}" />
            </StackPanel>
          </Border>

          <!-- Settings -->
          <Border Classes="section" IsVisible="{Binding IsSettingsSectionVisible}">
            <StackPanel>
              <ToggleButton Classes="sectionHeader" IsChecked="{Binding SettingsExpanded}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="chevron" />
                  <TextBlock Classes="title" Text="Settings" />
                  <TextBlock Classes="summary" Text="Overrides app defaults" IsVisible="{Binding HasSettingsOverrides}" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Spacing="18" Margin="0,4,0,12" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding SettingsExpanded}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Automatically follow redirects" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" FontSize="12" Text="Follow HTTP 3xx responses as redirects." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding FollowRedirects}" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Enable SSL certificate verification" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" FontSize="12" Text="Verify SSL certificates when sending a request." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerifySsl}" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Request timeout (ms)" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" FontSize="12" Text="Overrides the app-wide timeout for this request. Empty = use app setting, 0 = no timeout." />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding TimeoutText}" Width="120" PlaceholderText="Default" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Not used yet -->
          <Border Classes="section" Padding="0,12,0,0" IsVisible="{Binding HasUnusedSections}">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBlock Classes="tertiary" Text="Not used yet" FontSize="12" VerticalAlignment="Center" />
              <Button Classes="chip" Content="+ Query params" Command="{Binding AddSectionCommand}" CommandParameter="params"
                      IsVisible="{Binding !IsParamsSectionVisible}" />
              <Button Classes="chip" Content="+ Body" Command="{Binding AddSectionCommand}" CommandParameter="body"
                      IsVisible="{Binding !IsBodySectionVisible}" />
              <Button Classes="chip" Content="+ Settings" Command="{Binding AddSectionCommand}" CommandParameter="settings"
                      IsVisible="{Binding !IsSettingsSectionVisible}" />
            </WrapPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Row="1" Name="Splitter" ResizeDirection="Rows" Background="Transparent" />
      <Border Grid.Row="1" Name="SplitterLine" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />

      <v:ResponseView Grid.Row="2" Name="ResponsePane" DataContext="{Binding Response}" Margin="0,4,0,8" />
    </Grid>
  </Grid>
</UserControl>
