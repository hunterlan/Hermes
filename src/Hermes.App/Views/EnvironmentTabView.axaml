<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermes.App.ViewModels"
             xmlns:v="using:Hermes.App.Views"
             x:Class="Hermes.App.Views.EnvironmentTabView"
             x:DataType="vm:EnvironmentTabViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20,14,20,0">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <PathIcon Data="{StaticResource IconEnvironment}" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Name}" IsVisible="{Binding CanRename}" FontSize="16" FontWeight="SemiBold" MinWidth="260"
                 BorderThickness="0" Background="Transparent" Padding="4,2" />
        <TextBlock Classes="h1" Text="Globals" IsVisible="{Binding IsGlobals}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Classes="ghost" Content="Set active" Command="{Binding SetActiveCommand}" IsVisible="{Binding CanRename}"
                IsEnabled="{Binding !IsActiveEnvironment}" />
        <Button Classes="ghost" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource IconSave}" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,8,0,14">
      <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                 Text="Use variables as {{name}} in URLs, headers, bodies and auth. Environment variables override collection variables, which override globals." />
      <Border IsVisible="{Binding CanRename}" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="14,10" HorizontalAlignment="Left" MaxWidth="640">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Ask before sending" FontWeight="SemiBold" />
            <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                       Text="While this environment is active, every send shows the target and waits for confirmation. Use it for Production." />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding ConfirmBeforeSend}" OnContent="" OffContent="" Margin="12,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>
    <ScrollViewer Grid.Row="2">
      <v:VariableTable DataContext="{Binding Variables}" Margin="0,0,8,16" VerticalAlignment="Top" />
    </ScrollViewer>
  </Grid>
</UserControl>
