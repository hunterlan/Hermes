<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hermes.App.ViewModels"
        xmlns:c="using:Hermes.App.Controls"
        xmlns:v="using:Hermes.App.Views"
        xmlns:sbv="using:Hermes.App.Views.Sidebar"
        x:Class="Hermes.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hermes" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="Button.welcome">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.welcome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.welcomeIcon">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.welcomeIcon PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Border.statusBar TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.statusBar Button.ghost">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,26">
    <!-- header: app, sidebar toggle, active environment (always visible), settings. OS window decorations stay. -->
    <Border Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconLogo}" Foreground="{DynamicResource AccentBrush}" Width="18" Height="18" />
          <TextBlock Text="Hermes" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0" />
          <Button Classes="icon" Width="28" Height="28" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle sidebar (Ctrl+\)">
            <PathIcon Data="{StaticResource IconSidebar}" />
          </Button>
          <Button Classes="ghost" Command="{Binding NewRequestCommand}" ToolTip.Tip="New request (Ctrl+T)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{StaticResource IconPlus}" />
              <TextBlock Text="New" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenImportCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Import (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{StaticResource IconImport}" />
              <TextBlock Text="Import" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="2" Classes="outline" Width="420" MaxWidth="420" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch"
                Background="{DynamicResource BgTertiaryBrush}" BorderThickness="0" Margin="16,0" Command="{Binding OpenCommandPaletteCommand}"
                ToolTip.Tip="Search requests or run a command (Ctrl+K)">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Grid.Column="1" Text="Search requests or run a command" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl K" /></Border>
          </Grid>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- active environment: name always on screen; the flyout switches and previews values -->
          <Button Name="EnvironmentButton" Classes="outline" ToolTip.Tip="Active environment (Ctrl+E)"
                  AutomationProperties.Name="{Binding EnvironmentButtonText, StringFormat='Active environment: {0}. Change environment'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:EnvironmentColorDot Name="EnvironmentButtonDot" Color="{Binding ActiveEnvironmentColor}" />
              <TextBlock Text="ENV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding EnvironmentButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"
                         MaxWidth="200" TextTrimming="CharacterEllipsis" />
              <PathIcon Data="{StaticResource IconLock}" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"
                        IsVisible="{Binding ActiveEnvironmentConfirms}" ToolTip.Tip="Asks before sending" />
              <PathIcon Name="EnvironmentChevron" Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="picker"
                      Opened="OnEnvironmentPickerOpened" Closed="OnEnvironmentPickerClosed">
                <StackPanel Name="EnvironmentPicker">
                  <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,4" MinHeight="22">
                    <TextBlock Classes="caption" Text="SEND WITH" />
                    <Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl E" /></Border>
                  </Grid>
                  <!-- selection is only the keyboard cursor; Enter or a click makes an option active (the checkmark) -->
                  <ListBox Name="EnvironmentList" Classes="picker" ItemsSource="{Binding EnvironmentOptions}"
                           MaxHeight="232" AutomationProperties.Name="Environments"
                           Tapped="OnEnvironmentListTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EnvironmentOption">
                        <Grid ColumnDefinitions="16,*,Auto,Auto" ColumnSpacing="10">
                          <c:EnvironmentColorDot Color="{Binding Color}" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                     Classes.secondary="{Binding IsMuted}" Classes.active="{Binding IsActive}" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding AsksFirst}">
                            <PathIcon Data="{StaticResource IconLock}" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Classes="tertiary" FontSize="11" Text="asks first" VerticalAlignment="Center" />
                          </StackPanel>
                          <PathIcon Grid.Column="3" Data="{StaticResource IconCheck}" Width="14" Height="14"
                                    Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border Classes="picker-rule" />
                  <StackPanel IsVisible="{Binding HasActiveEnvironment}">
                    <Grid ColumnDefinitions="*,Auto" Margin="14,4,14,4">
                      <TextBlock Classes="caption" Text="{Binding QuickLookEnvironmentTitle, Converter={x:Static vm:UiConverters.Upper}}" />
                      <Button Grid.Column="1" Classes="link" Content="Edit" FontSize="12" Command="{Binding EditActiveEnvironmentCommand}" />
                    </Grid>
                    <v:QuickLookTable DataContext="{Binding QuickLookEnvironment}" Margin="14,0,14,8" />
                  </StackPanel>
                  <Border IsVisible="{Binding !HasActiveEnvironment}" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="7"
                          Margin="14,2,14,10" Padding="12,10">
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                               Text="Requests use Globals only. Pick an environment above to layer its values on top." />
                  </Border>

                  <Border Classes="picker-rule" />
                  <Grid ColumnDefinitions="*,Auto" Margin="14,4,14,4">
                    <TextBlock Classes="caption" Text="{Binding QuickLookGlobalsTitle, Converter={x:Static vm:UiConverters.Upper}}" />
                    <Button Grid.Column="1" Classes="link" Content="Edit" FontSize="12" Command="{Binding EditGlobalsCommand}" />
                  </Grid>
                  <v:QuickLookTable DataContext="{Binding QuickLookGlobals}" Margin="14,0,14,8" />

                  <Button Classes="picker-footer" Command="{Binding OpenEnvironmentMatrixCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <PathIcon Data="{StaticResource IconEnvironment}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1" Text="Open environments matrix" VerticalAlignment="Center" />
                      <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                                Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon" Width="28" Height="28" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)">
            <PathIcon Data="{StaticResource IconSettings}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Name="BodyGrid" ColumnDefinitions="272,*">
      <!-- sidebar: one segmented switch instead of an icon rail -->
      <Border Name="SidebarHost" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0" IsVisible="{Binding IsSidebarVisible}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="seg" Margin="12,10,12,2">
            <Grid ColumnDefinitions="1*,1.25*,0.8*">
              <ToggleButton Classes="seg" Content="Collections" Padding="4,3" IsChecked="{Binding IsCollectionsPane, Mode=OneWay}"
                            Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:SidebarPane.Collections}" />
              <ToggleButton Grid.Column="1" Classes="seg" Content="Environments" Padding="4,3" IsChecked="{Binding IsEnvironmentsPane, Mode=OneWay}"
                            Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:SidebarPane.Environments}" />
              <ToggleButton Grid.Column="2" Classes="seg" Content="History" Padding="4,3" IsChecked="{Binding IsHistoryPane, Mode=OneWay}"
                            Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:SidebarPane.History}" />
            </Grid>
          </Border>
          <Panel Grid.Row="1">
            <sbv:CollectionsPaneView DataContext="{Binding Collections}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsCollectionsPane}" />
            <sbv:EnvironmentsPaneView DataContext="{Binding Environments}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsEnvironmentsPane}" />
            <sbv:HistoryPaneView DataContext="{Binding History}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsHistoryPane}" />
          </Panel>
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconFile}" Width="13" Height="13" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Grid.Column="1" Classes="mono tertiary" Text="Plain files on disk" FontSize="12" Margin="8,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="link" Content="Reveal" FontSize="12" Command="{Binding RevealDataDirectoryCommand}"
                      ToolTip.Tip="{Binding DataDirectory}" />
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Name="SidebarSplitter" Width="5" HorizontalAlignment="Right" Background="Transparent"
                    ResizeDirection="Columns" IsVisible="{Binding IsSidebarVisible}" />

      <!-- main area -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <!-- tab strip -->
        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6,8,0" IsVisible="{Binding IsTabStripVisible}">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TabViewModelBase">
                    <v:TabHeader />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="1" Classes="icon" Margin="4,0,0,2" VerticalAlignment="Center" Command="{Binding NewRequestCommand}" ToolTip.Tip="New tab (Ctrl+T)">
              <PathIcon Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>
        </Border>

        <!-- active tab -->
        <ContentControl Grid.Row="1" Content="{Binding ActiveTab}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:RequestTabViewModel">
              <v:RequestTabView />
            </DataTemplate>
            <DataTemplate DataType="vm:CollectionTabViewModel">
              <v:CollectionTabView />
            </DataTemplate>
            <DataTemplate DataType="vm:FolderTabViewModel">
              <v:FolderTabView />
            </DataTemplate>
            <DataTemplate DataType="vm:EnvironmentTabViewModel">
              <v:EnvironmentTabView />
            </DataTemplate>
            <DataTemplate DataType="vm:EnvironmentMatrixTabViewModel">
              <v:EnvironmentMatrixView />
            </DataTemplate>
            <DataTemplate DataType="vm:HelpTabViewModel">
              <v:HelpView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- no tabs -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="1" IsVisible="{Binding !HasTabs}">
          <StackPanel Width="440" Spacing="0" Margin="56,48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconLogo}" Width="40" Height="40" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Send a request." FontSize="32" FontWeight="SemiBold" Margin="0,14,0,6" TextAlignment="Center" />
            <TextBlock Classes="secondary" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,24" TextAlignment="Center"
                       Text="There is no sign-up and no cloud. Everything is kept as plain JSON files in your data folder." />
            <StackPanel Spacing="10">
              <Button Classes="welcome" Command="{Binding NewRequestCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="welcomeIcon"><PathIcon Data="{StaticResource IconPlus}" /></Border>
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="New request" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="secondary" FontSize="12.5" Text="Paste a cURL command into the URL bar to import it" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl T" /></Border>
                </Grid>
              </Button>
              <Button Classes="welcome" Command="{Binding OpenImportCommand}" CommandParameter="{x:Null}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="welcomeIcon"><PathIcon Data="{StaticResource IconImport}" /></Border>
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="Import" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="secondary" FontSize="12.5" Text="Postman collection or environment, cURL" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl O" /></Border>
                </Grid>
              </Button>
              <Button Classes="welcome" Command="{Binding Collections.NewCollectionCommand}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="welcomeIcon"><PathIcon Data="{StaticResource IconFolderOutline}" /></Border>
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="New collection" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="secondary" FontSize="12.5" Text="Group requests and share auth and variables" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="welcome" Command="{Binding OpenManualCommand}" CommandParameter="{x:Null}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="welcomeIcon"><PathIcon Data="{StaticResource IconHelp}" /></Border>
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="User manual" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="secondary" FontSize="12.5" Text="Works offline" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="kbd"><TextBlock Text="F1" /></Border>
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- status bar -->
    <Border Grid.Row="2" Classes="statusBar" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="14,0,8,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Classes="mono" Text="{Binding DataDirectory}" TextTrimming="PathSegmentEllipsis" MaxWidth="520" />
        <Border Grid.Column="1" Classes="tag warn" HorizontalAlignment="Right" Margin="0,0,8,0" IsVisible="{Binding AreSecretsUnprotected}"
                ToolTip.Tip="{Binding SecretsWarning}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconAlert}" Width="11" Height="11" />
            <TextBlock Text="Secrets not protected" />
          </StackPanel>
        </Border>
        <Button Grid.Column="2" Classes="ghost" Content="Cookies" Command="{Binding OpenCookiesCommand}" ToolTip.Tip="Manage cookies" />
        <Button Grid.Column="3" Classes="ghost" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle light / dark theme">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconSun}" Width="12" Height="12" />
            <TextBlock Text="Theme" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="4" Text="{Binding AppVersion}" Margin="8,0,6,0" />
      </Grid>
    </Border>

    <!-- command palette (Ctrl+K) -->
    <Panel Grid.RowSpan="3" IsVisible="{Binding CommandPalette.IsOpen}" ZIndex="100">
      <Border Background="#66000000" PointerPressed="OnPaletteBackdropPressed" />
      <Border Width="620" MaxHeight="460" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0"
              Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" BoxShadow="0 12 32 0 #59000000" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <TextBox Name="PaletteBox" Text="{Binding CommandPalette.Query}" PlaceholderText="Search requests by name, method or URL, or type a command"
                   BorderThickness="0,0,0,1" CornerRadius="0" Background="Transparent" MinHeight="46" Padding="10,0" KeyDown="OnPaletteKeyDown">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="14,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ListBox Grid.Row="1" Name="PaletteList" ItemsSource="{Binding CommandPalette.Results}" SelectedItem="{Binding CommandPalette.Selected}"
                   Background="Transparent" Padding="6" Tapped="OnPaletteItemTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="56,*,Auto" MinHeight="30">
                  <c:MethodBadge Method="{Binding Method}" Compact="True" FontSize="10" IsVisible="{Binding IsRequest}" VerticalAlignment="Center" />
                  <PathIcon Data="{StaticResource IconArrowRight}" Width="12" Height="12" IsVisible="{Binding !IsRequest}"
                            Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Left" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="tertiary" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="kbd" IsVisible="{Binding HasShortcut}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Shortcut}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Panel>
  </Grid>
</Window>
