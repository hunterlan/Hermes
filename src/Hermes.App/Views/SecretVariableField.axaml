<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hermes.App.Controls"
             xmlns:v="using:Hermes.App.Views"
             x:Class="Hermes.App.Views.SecretVariableField">
  <Grid ColumnDefinitions="*,Auto">
    <!-- the frame stays visible while the input under the dots is hidden -->
    <Border Classes="inputFrame">
      <Panel Classes="valueCell" Classes.masked="{Binding $parent[v:SecretVariableField].Secret.ShowMask}">
        <c:VariableTextBox Text="{Binding $parent[v:SecretVariableField].Text, Mode=TwoWay}"
                           PlaceholderText="{Binding $parent[v:SecretVariableField].PlaceholderText}" Margin="8,0" />
        <TextBlock Classes="mono maskDots" Text="{Binding $parent[v:SecretVariableField].Secret.DisplayValue}" Margin="8,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" />
      </Panel>
    </Border>
    <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" VerticalAlignment="Center"
            IsVisible="{Binding $parent[v:SecretVariableField].Secret.IsSensitive}"
            Command="{Binding $parent[v:SecretVariableField].Secret.ToggleRevealCommand}"
            ToolTip.Tip="{Binding $parent[v:SecretVariableField].Secret.RevealToolTip}"
            AutomationProperties.Name="{Binding $parent[v:SecretVariableField].Secret.RevealToolTip}">
      <Panel>
        <PathIcon Data="{StaticResource IconEye}" IsVisible="{Binding !$parent[v:SecretVariableField].Secret.IsRevealed}" />
        <PathIcon Data="{StaticResource IconEyeOff}" IsVisible="{Binding $parent[v:SecretVariableField].Secret.IsRevealed}" />
      </Panel>
    </Button>
  </Grid>
</UserControl>
